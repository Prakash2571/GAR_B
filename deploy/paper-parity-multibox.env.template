# ═══════════════════════════════════════════════════════════════════════════════════════════════
#  MULTI-BOX PAPER REHEARSAL — paper_legging + live_parity, wide universe, several boxes
# ═══════════════════════════════════════════════════════════════════════════════════════════════
#
# WHAT THIS PROFILE IS FOR. Running the strategy at realistic breadth and concurrency, against real
# Zerodha books, with the live scheduling/liquidity/latency model layered on — WITHOUT sending an
# order. It is the rehearsal you run for a session or a day to answer "does this find and manage
# boxes at all, and what does the funnel actually look like", BEFORE narrowing to a single
# supervised live attempt (deploy/FINAL-one-box-live.env.template).
#
# IT IS NOT A SAFETY PROFILE. Several ceilings here are deliberately WIDER than any live template,
# because the point is throughput of observation. Do not promote this file to live by flipping §1 —
# copy the live template instead and re-narrow §3 and §4 explicitly.
#
# OPERATIONAL CONFIGURATION ONLY — THERE ARE NO CREDENTIALS IN THIS FILE, BY DESIGN. Broker keys,
# the token-encryption key, the site passcode and the database DSNs are classified `secret` in
# src/env/secrets.ts and live in the protected secrets file (/etc/gts/secrets.env, 0600, outside the
# working tree). See §9. Every one of the 53 assignments below is a risk/behaviour setting an
# operator tunes between sessions — safe to read in full, safe to diff, safe to commit.
#
# ── HOW TO USE ──
#   1. Copy to .env. Only ONE line needs a value chosen (§3, the paper capital mirror); everything
#      else is set. Then restart.
#   2. `node --import ./dist/env/boot.js dist/box/effectiveConfig.js` and read back §1, §3, §4, §5
#      and §6. Use the boot loader flag, or .env and the secrets file are not applied.
#   3. Log in to Zerodha — a paper run still needs a real session, because the fills are simulated
#      from the real book.
#   4. Arm the session with the Session tab's custom "N" field — NOT "Arm one-shot (1)" and NOT
#      "Arm unlimited". See §4.
#   5. RUN.
#
# ── WHAT THIS REHEARSAL CANNOT PROVE (read before trusting it) ──
# `BoxOrderManager` is constructed ONLY under BOX_EXECUTION_MODE=live (src/box/engine.ts), and it
# owns every BOX_LIVE_* limit. So in paper NONE of these are exercised, whatever you set them to:
#   BOX_LIVE_MAX_OPEN_BOXES · BOX_LIVE_MAX_OPEN_LEG_QUANTITY · BOX_LIVE_MAX_GROSS_OPEN_LEG_QUANTITY
#   BOX_LIVE_MAX_BOX_CAPITAL_RUPEES · BOX_LIVE_MAX_RESIDUAL_LEGS · BOX_LIVE_DAILY_LOSS_LIMIT
#   BOX_LIVE_REJECT_LIMIT · BOX_LIVE_CONSECUTIVE_FAILURE_LIMIT · the BOX_LIVE_REQUIRE_* funding
#   gates · BOX_LIVE_ENTRY_SUBMIT_CONCURRENCY · the broker pacing intervals.
# The sharp consequence of a WIDE universe in paper: large-lot names (PAYTM 725, IDEA, YESBANK)
# become eligible and nothing refuses them, whereas live would refuse them at the per-leg quantity
# cap before the first order left. Either accept that gap knowingly, or exclude those names at
# runtime via POST /api/box/excluded-underlyings (enforced in paper — two of its four enforcement
# points are the paper simulator and the coordinator prologue).
# Also inert in paper: the three live control switches (box_entry_enabled, box_live_order_enabled,
# box_emergency_flatten) all return HTTP 409, and the ENTRY DISARMED / LIVE ORDERS UNAVAILABLE /
# RECONCILIATION INCOMPLETE badges are artifacts of the absent order manager, not blockers.


# ── §1. EXECUTION POSTURE — PAPER, WITH THE LIVE MODEL LAYERED ON ────────────────────────────────
# paper_legging is the only paper mode that models four independent leg orders, so it is the only
# one whose failure modes resemble live. live_parity then adds the shared-liquidity ledger, the
# structured broker-latency source and the LIVE scheduling policy on top.
BOX_EXECUTION_MODE=paper_legging
BOX_PAPER_EXECUTION_PROFILE=live_parity
# Both false, and mutually exclusive with live — restated so a copy-paste cannot re-enable them.
BOX_LIVE_TRADING_ENABLED=false
ZERODHA_LIVE_TRADING_ENABLED=false
BOX_SHADOW_MODE_ENABLED=false
#
# ⚠ LOAD-BEARING AND UNGUARDED IN PAPER. Live REFUSES TO BOOT if this is false; paper does not.
#   With it false, simulateLeggingEntry delegates straight past the coordinator prologue, silently
#   removing BOX_MAX_OPEN_BOXES, BOTH session budgets, BOX_ONE_ACTIVE_BOX_PER_UNDERLYING, the
#   duplicate-opportunity guard and every instrument reservation — i.e. every limit in §3 and §4.
BOX_EXECUTION_COORDINATOR_ENABLED=true


# ── §2. LATENCY AND CALIBRATION (live_parity only) ──────────────────────────────────────────────
# `constant` until you have exported real POST→ACK samples from a live run's broker-timing store.
# Switch to recorded_samples and populate the two sample lists once you have them — that is what
# turns "parity" from a model into a measurement.
BOX_PAPER_LATENCY_MODE=constant
BOX_PAPER_LATENCY_SAMPLES=
BOX_PAPER_LATENCY_ACK_TERMINAL_SAMPLES=
BOX_PAPER_LATENCY_SEED=
BOX_PAPER_CANCEL_LATENCY_MS=150
BOX_PAPER_PERSISTENCE_MS=0
BOX_PAPER_CALIBRATION_MIN_SAMPLES=30
BOX_PAPER_CALIBRATION_BUCKET_MIN_SAMPLES=60
BOX_PAPER_CALIBRATION_MAX_AGE_MS=604800000
BOX_PAPER_CALIBRATION_TIME_BUCKETS=true


# ── §3. CONCURRENCY AND INVENTORY — THE "MULTIPLE BOXES" PART ────────────────────────────────────
# THE INVENTORY CEILING, enforced in the coordinator prologue in EVERY mode against committed
# exposure (open positions + unresolved residuals + in-flight entry pipelines + reservations held
# over an uncertain outcome). This is the number that decides how many boxes you can hold AT ONCE.
# 4 is a deliberate, observable figure — wide enough to exercise concurrency, small enough to read
# on one screen. 0 = unlimited; raise it if you specifically want to stress inventory.
BOX_MAX_OPEN_BOXES=4
#
# Cap on simultaneous paper execution pipelines under live_parity. Range 1..8, and note that 0 does
# NOT mean unlimited here — it clamps up to 1. Left UNSET it inherits the LIVE cap, which defaults
# to 1, and one pipeline across a 200-name universe is the single most common reason a wide paper
# run produces almost no attempts. Set it explicitly, and set it to what you intend to run live so
# the scheduling parity is real.
BOX_PAPER_MAX_CONCURRENT_EXECUTIONS=4
#
# Keep the per-underlying posture IDENTICAL to live. One box per name is what live runs, so relaxing
# it here would make the rehearsal's concurrency profile unlike the thing being rehearsed. You still
# get many boxes — just on many different underlyings, which is the realistic shape.
BOX_ONE_ACTIVE_BOX_PER_UNDERLYING=true
BOX_MAX_CONCURRENT_PER_UNDERLYING=1
#
# The paper mirror of the per-box capital cap. Set it to the SAME rupee figure as
# BOX_LIVE_MAX_BOX_CAPITAL_RUPEES in your live template, or the paper run never exercises the
# capital admission arithmetic at all. 0 = disabled.
# EDIT: match your intended live per-box capital cap
BOX_PAPER_MAX_BOX_CAPITAL_RUPEES=100000


# ── §4. SESSION BUDGETS — BOUNDED, BUT NOT ONE-SHOT ─────────────────────────────────────────────
# Two INDEPENDENT budgets. A CYCLE is spent by SUCCEEDING (a four-leg box is established); an
# ATTEMPT is spent by STARTING (at admission, before any order). Both gate entry.
#
# CYCLES: how many boxes may be established this session. Bounded rather than unlimited on purpose —
# a number you can reason about beats "it ran all day and I am not sure what happened".
BOX_SESSION_MAX_COMPLETED_TRADES=25
#
# ATTEMPTS: generous, because in PAPER an attempt costs nothing — no order, no charges, no rate
# limit beyond the feed. A tight attempt budget in paper just ends the rehearsal on the first
# `price_moved` near-miss. THIS IS THE OPPOSITE OF THE LIVE SETTING: in live every attempt can post
# real orders, so the live templates set it to 1 and mean it.
BOX_SESSION_MAX_ENTRY_ATTEMPTS=500
#
# ⚠ THE CEILINGS ARE SNAPSHOTTED AT ARM TIME, so editing this file does NOT widen a session that is
#   already armed — you must Disarm, then Arm again. And the UI's Arm button only ever sends the
#   CYCLE ceiling: the attempt ceiling always comes from the value above. So arm with the Session
#   tab's custom "N" field set to 25 (or whatever you set for cycles). "Arm one-shot (1)" gives you
#   one box; "Arm unlimited" removes the cycle bound entirely and leaves only the attempt budget.
#
# ⚠ THE SESSION LAYER IS INERT WITHOUT A DATABASE. With no DATABASE_URL, evaluateEntry returns
#   allowed:true and BOTH budgets above do nothing. PostgreSQL is not optional for this rehearsal.
#
# ⚠ In paper the SESSION badge reads BLOCKED even when freshly armed with full budget (the state
#   derivation folds in an external-gate flag that has no order manager to read). Confirm via
#   GET /api/box/execution-control → session: `block_reason: null` and `remaining_entry_attempts`.


# ── §5. THE UNIVERSE — WIDE, WHICH IS THE POINT ─────────────────────────────────────────────────
# 0 = NO CAP (this is a DISCOVERY cap, applied while building strike windows — a capped-out name
# gets no window, no candidates and is never priced, so you cannot monitor it). At any positive
# value you do NOT choose WHICH names survive: it is the board's own priority order, indices first
# then alphabetical.
BOX_MAX_UNDERLYINGS=0
#
# ATM ±1 keeps the token cost per underlying at roughly a third of ±3, which is what lets the whole
# board fit inside the subscription budget. Measured: ~207 underlyings ≈ 1449 tokens at level 1.
BOX_STRIKE_LEVEL=1
BOX_MAX_SUBSCRIBED_TOKENS=2200
BOX_INDICATIVE_MAX_UNDERLYINGS=150
BOX_INDICATIVE_DISCOVERY=true
BOX_ENABLE_SHORT_BOX=false
# Dedicated socket for box strikes so they are not displaced by the shared board feed. This also
# materially reduces receive-time dispersion (see §6): legs updated in the same delivered frame get
# an identical received_at, so fewer legs land frames apart.
BOX_DEDICATED_MARKET_FEED=true
#
# THE BLOCKLIST IS NOT AN ENV VAR — there is deliberately no BOX_EXCLUDED_UNDERLYINGS. It is
# operator state, held in box_excluded_underlyings and managed at RUNTIME with no restart:
#   GET    /api/box/excluded-underlyings
#   POST   /api/box/excluded-underlyings        {"symbol":"PAYTM","reason":"lot 725 over live cap"}
#   POST   /api/box/excluded-underlyings/bulk
#   DELETE /api/box/excluded-underlyings/PAYTM
# Set it BEFORE pressing RUN if you want large-lot names kept out of the rehearsal (see the blind
# spot noted at the top of this file). It is enforced in paper, and it is subordinate to open
# exposure — excluding a name never unsubscribes a book an open position still needs to exit.


# ── §6. FRESHNESS AND FOUR-LEG COHERENCE ────────────────────────────────────────────────────────
# These bound DISPERSION BETWEEN THE FOUR LEGS, not absolute latency — all four books arrive over
# the same socket, so a uniformly slower path shifts all four equally and leaves the spread alone.
BOX_QUOTE_MAX_AGE_MS=15000
BOX_FEED_MAX_AGE_MS=5000
#
# THE PRECISE, ALWAYS-AVAILABLE GATE. Measured against OUR OWN arrival clock, which is millisecond
# resolution. This is the one doing the real sub-second work, and the one to tighten if you want
# stricter coherence.
BOX_MAX_CROSS_LEG_RECEIVE_DISPERSION_MS=500
#
# A COARSE SANITY CHECK ONLY, and it must not be set below the broker's stamp precision. Kite stamps
# books in epoch SECONDS, so cross-leg exchange dispersion can only be 0, 1000, 2000 … ms: four
# books published 160 ms apart measure 0 ms within a second and 1000 ms across a boundary. Any limit
# under 1000 therefore refuses coherent books on quantisation alone — that is not strictness, it is
# an unsatisfiable bound, and it produced a 100%-refusal paper session. 1000 still catches genuinely
# separated stamps (15s/18s/15s/19s = 4000 ms). 0 disables it and leaves receive-time as the sole
# gate. The engine now warns loudly at boot if this is below the active broker's precision.
BOX_MAX_CROSS_LEG_EXCHANGE_DISPERSION_MS=1000
BOX_MAX_RECEIVE_TO_EXCHANGE_DELAY_MS=5000
BOX_COHERENCE_ZERO_DISPERSION_DISABLES_IN_LIVE=false
#
# ⚠ CHECK THE HOST CLOCK. Skew makes exchange stamps look "ahead of receive time" and trips
#   clock_anomaly, which reads on screen as market conditions. `chronyc tracking`, offset well
#   inside a millisecond. On Azure use the host PTP/VMICTimeSync source, NOT the AWS
#   169.254.169.123 endpoint.


# ── §7. ECONOMICS — DO NOT LOOSEN THESE FOR THE REHEARSAL ───────────────────────────────────────
# Lowering the entry gate to "see more fills" makes the rehearsal stop predicting which boxes are
# actually profitable, which is the only thing it was for. Keep them identical to your live values.
BOX_MIN_EXPECTED_NET_PROFIT=1200
MIN_BOX_GROSS_EDGE=1200
MIN_BOX_NET_EDGE=0
BOX_SAFETY_BUFFER=150
BOX_EXPECTED_ENTRY_SLIPPAGE=250
BOX_EXPECTED_EXIT_SLIPPAGE=250
BOX_REQUIRE_PRICED_CHARGES=true
BOX_QUEUE_MODEL=haircut
BOX_QUEUE_LIQUIDITY_HAIRCUT_PCT=30


# ── §8. EXIT — MODE-INDEPENDENT, SO THE REHEARSAL IS HONEST HERE ────────────────────────────────
# The exit decision (EDGE_CONVERGED / PROFIT_CAPTURE / EXPIRY_SAFETY) is shared with live.
BOX_MIN_EXIT_NET_PNL=600
BOX_CONVERGENCE_FLOOR=200
BOX_CONVERGENCE_PCT=0.2
BOX_PROFIT_CAPTURE_PCT=0.75
BOX_MIN_CAPTURED_PCT=0.75
BOX_EXIT_USE_REALISABLE=true
BOX_EXPIRY_SAFETY_MINUTES=45
BOX_MONITOR_INTERVAL_MS=1000
#
# ⚠ ONE REAL PAPER/LIVE ASYMMETRY ON EXIT. paper_legging gates the exit on the WHOLE position being
#   executable, where live isolates per leg. So paper will refuse some exits with
#   EXIT_SKIPPED_LIQUIDITY that live would have partially closed. Expect it; it is not a fault.


# ── §9. PERSISTENCE — REQUIRED, BUT NOT CONFIGURED HERE ─────────────────────────────────────────
# THIS FILE CARRIES NO CREDENTIALS, DELIBERATELY. `DATABASE_URL`, `MONGODB_URI`, the broker keys, the
# token-encryption key and the site passcode are all classified `secret` in src/env/secrets.ts and
# belong in the PROTECTED SECRETS FILE — by default /etc/gts/secrets.env, root-owned and 0600,
# outside the working tree so no `git add -A` can commit it and no deploy can destroy it. Override
# the path with GTS_SECRETS_FILE.
#
# The loader applies exactly this order, and nothing later overrides anything earlier:
#     explicit process environment  >  protected secrets file  >  this .env  >  code default
# So a deployment can rotate credentials without touching risk configuration, and you can edit risk
# configuration without ever opening a file containing a broker secret.
#
# ⚠ POSTGRESQL IS STILL REQUIRED FOR THIS REHEARSAL, it is simply configured elsewhere. Without
#   DATABASE_URL reaching the process, `evaluateEntry` returns allowed:true and BOTH session budgets
#   in §4 silently do nothing — no cap, no attempt accounting — and no attempt or trade is recorded,
#   so the run leaves no reviewable history. Confirm it is present before you arm:
#       node --import ./dist/env/boot.js dist/box/effectiveConfig.js
#   which reports DSN-shaped secrets by provenance without printing their values.


# ── §10. WHAT TO WATCH ──────────────────────────────────────────────────────────────────────────
# Alerts bell            which underlying was refused and why, with exact counts and a remedy.
#                        `actionable` groups are the ones needing you; `market` is normal churn.
# Free to trade          the account balance, polled in paper too.
# EXECUTION HEALTH       attempts / failed / rejection_categories. A single category at 100% is
#                        almost always configuration, not the market — check the alert detail.
# GET /api/box/status    `underlyings`, `skipped_underlying_cap_symbols` (excluded by §5's cap) vs
#                        `skipped_symbols` (excluded by the token budget) — two different limits.
# GET /api/box/execution-attempts   per-attempt rows, once legs have actually filled.
#
# ── BEFORE PROMOTING TO LIVE ──
# Copy deploy/FINAL-one-box-live.env.template instead of editing this file, and re-narrow:
#   BOX_SESSION_MAX_ENTRY_ATTEMPTS=1 · BOX_SESSION_MAX_COMPLETED_TRADES=1 · BOX_MAX_OPEN_BOXES=1
#   and re-check every BOX_LIVE_* quantity/capital ceiling against the instrument you intend to
#   trade, because they begin enforcing for the first time the moment the order manager exists.
