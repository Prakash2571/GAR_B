# ═════════════════════════════════════════════════════════════════════════════
# GTS Algo Research — ONE SUPERVISED LIVE BOX ATTEMPT
#
# The narrowest possible live configuration: ONE four-leg Box entry attempt, ONE
# lot per leg, ONE globally bounded Box, all intended underlyings monitored, under
# continuous human supervision, with every funding gate armed and every ceiling
# set explicitly.
#
# ── WHAT THIS FILE IS ────────────────────────────────────────────────────────
# A TEMPLATE to be reviewed, copied and edited. It is NOT the production `.env`
# and must never be copied over one without a line-by-line diff: several values
# here are deliberately STRICTER than the production profile and would stop a
# normal paper run from doing anything.
#
# ── WHAT THIS FILE IS NOT ────────────────────────────────────────────────────
#   · It contains NO secret, NO token, NO API key and NO account id.
#   · It does NOT arm live trading. `BOX_EXECUTION_MODE` is left COMMENTED OUT
#     below, so applying this file as-is cannot place an order.
#   · It is NOT evidence that a Box will fill, or profit, or that the deployment
#     has passed its runtime gates. See EVIDENCE-supervised-live-test-readiness.md
#     for what is proven and what is still owed.
#
# ── HOW TO VERIFY WHAT IS ACTUALLY IN FORCE ──────────────────────────────────
# Never trust this file as a description of the running process. Values can be
# overridden by the shell, by PM2's own env, or by an ecosystem file. Confirm the
# EFFECTIVE resolved values and their provenance with:
#
#     node dist/box/effectiveConfig.js
#
# SAFETY-LIMIT PARSING: both session ceilings and the all-mode inventory ceiling
# are strict whole-number containment limits. An explicit malformed, fractional,
# negative, or out-of-range value REFUSES BOOT; it never falls back to 0
# (unlimited). Read the effective-config output anyway: it confirms the value
# inherited from the actual process environment, not merely this template.
# ═════════════════════════════════════════════════════════════════════════════


# ── 1. EXECUTION MODE — DELIBERATELY NOT SET ─────────────────────────────────
# Uncomment the next line ONLY at the moment of the supervised attempt, with an
# operator watching, and revert it immediately afterwards.
#
# BOX_EXECUTION_MODE=live
#
# Until then the process runs in simulated execution:
BOX_EXECUTION_MODE=paper_latency

# THREE independent switches must ALL be armed before a real Zerodha order can be
# placed. They are independent on purpose: no single stray variable can arm live.
#   1. BOX_EXECUTION_MODE=live         — the mode itself (above)
#   2. BOX_LIVE_TRADING_ENABLED=true   — deployment kill switch; `live` without it
#                                        is REJECTED AT BOOT (process.exit(1))
#   3. ZERODHA_LIVE_TRADING_ENABLED    — the per-broker switch (see below)
BOX_LIVE_TRADING_ENABLED=false
ZERODHA_LIVE_TRADING_ENABLED=false

# NOTE ON SWITCH 3. This switch was, until recently, DECORATIVE for Zerodha: it
# produced the readiness blocker `zerodha_live_trading_disabled` whose text claimed
# "Zerodha will take no new entry", but nothing enforced it and a real order was
# still POSTed. It is now enforced in `ActiveBrokerManager.createLiveAdapter`,
# which REFUSES TO BUILD the Zerodha execution adapter unless it is armed — no
# adapter, no transport, no possible order. It also now feeds `trading_ready`, so
# the dashboard stops claiming "ready to trade" on the strength of a token alone.
# Unset means FALSE (fail closed), matching the Dhan switch.

BOX_SHADOW_MODE_ENABLED=false             # shadow can never place an order
BOX_PAPER_EXECUTION_PROFILE=standard      # `stress` is rejected in live


# ── 2. THE ONE-ATTEMPT BOUND ─────────────────────────────────────────────────
# Two ceilings, bounding two DIFFERENT things. Both are required.
#
#   COMPLETED TRADES bounds SUCCESS. A cycle is consumed when a full four-leg Box
#   is ESTABLISHED. An attempt that submits legs, partially fills and is unwound
#   establishes nothing and spends NO cycle — correctly, because burning the
#   permitted trade on an attempt that left no position would be indefensible.
#
#   ENTRY ATTEMPTS bounds RISK-TAKING. This is the ceiling that stops a trial
#   "configured for one trade" from submitting orders indefinitely so long as no
#   attempt ever completes. Consumed at ADMISSION, before any broker POST.
BOX_SESSION_MAX_COMPLETED_TRADES=1
BOX_SESSION_MAX_ENTRY_ATTEMPTS=1

# DURABILITY (verified, not assumed): the attempt counter is a PostgreSQL row
# (`box_trading_session`), incremented under a serialized critical section that
# re-evaluates the budget inside the lock, and it FAILS CLOSED — if the durable
# write fails the attempt is refused and rolled back rather than started. A PM2
# restart does not hand the attempt back; an unreadable session row refuses entry
# rather than assuming an unarmed session. Aborts never decrement it.
#
# ⚠ NO BOX POSTGRESQL DATABASE ⇒ THE ENTIRE SESSION-BUDGET LAYER IS INERT.
#   With persistence unavailable these two ceilings count nothing. Live entry is
#   separately blocked while `health.persistence` is not healthy, so this is not an
#   open door — but do not run the attempt without confirming the DB is connected.

# ⚠ RE-ARM IS REQUIRED. Both ceilings are SNAPSHOTTED INTO THE SESSION ROW when
#   the session is armed. Editing this file and restarting does NOT retroactively
#   bind an already-armed session: it will keep whatever ceiling it was armed with,
#   including 0 = unlimited. This is the single most likely way to believe the
#   bound is on while it is off. Either arm a fresh session after the env is in
#   place, or pass the ceilings explicitly (both are now accepted; `max_entry_
#   attempts` used to be silently dropped by this route):
#
#     POST /api/box/session/arm
#     { "max_completed_trades": 1, "max_entry_attempts": 1 }
#
#   Then CONFIRM on the status endpoint that the session reports
#   `max_entry_attempts: 1` and `remaining_entry_attempts: 1`.


# THE SUPERVISED ONE-LOT TRIAL PROFILE. Changes no behaviour itself: it makes the four one-shot
# bounds MANDATORY, refusing STARTUP unless BOX_MAX_OPEN_BOXES, BOX_LIVE_MAX_OPEN_BOXES,
# BOX_SESSION_MAX_COMPLETED_TRADES and BOX_SESSION_MAX_ENTRY_ATTEMPTS are ALL exactly 1. Three of
# those four default to 0 = UNLIMITED, so omitting one is not a narrower trial but an unbounded one,
# and nothing previously said so. Verify on the host, with this file loaded:
#   node dist/box/effectiveConfig.js --supervised-trial --lot-size=<lot size from the live master>
BOX_SUPERVISED_ONE_LOT_TRIAL=true

# ── 3. ONE BOX GLOBALLY, ALL INTENDED UNDERLYINGS WATCHED, NO RESIDUAL TOLERANCE ─
# The global coordinator guard is the authoritative one-box ceiling. It counts
# open boxes, entry pipelines and unresolved partial/ambiguous exposure BEFORE a
# broker request, across every underlying and every mode.
BOX_MAX_OPEN_BOXES=1
BOX_EXECUTION_COORDINATOR_ENABLED=true   # mandatory in live; pin it explicitly.
# This live-manager cap is a second, post-admission defence; it does not replace
# BOX_MAX_OPEN_BOXES above.
BOX_LIVE_MAX_OPEN_BOXES=1                 # ⚠ 0 does NOT mean unlimited here — the
                                          #   guard is `openBoxes >= limit`, so 0
                                          #   means NO box may EVER open.
BOX_LIVE_MAX_CONCURRENT_EXECUTIONS=1
# Two BUY hedges may transmit as one protected wave; dependent SELLs remain held
# until their hedge proof exists. This reduces inter-leg timing without admitting
# a second box or a naked SELL.
BOX_LIVE_ENTRY_SUBMIT_CONCURRENCY=2
BOX_MAX_CONCURRENT_PER_UNDERLYING=1
BOX_ONE_ACTIVE_BOX_PER_UNDERLYING=true    # code default is false — ON here.
                                          #   This is the limit that DOES count
                                          #   partial, residual, recovering and
                                          #   in-flight exposure, so it is what
                                          #   actually blocks a second attempt on
                                          #   the same underlying after an abort.

BOX_LIVE_MAX_RESIDUAL_LEGS=0              # ⚠ the comparison is STRICTLY GREATER
                                          #   (`residualLegs > limit`), so the code
                                          #   default of 1 TOLERATES one unresolved
                                          #   residual leg before blocking entry.
                                          #   0 is the only value that blocks on the
                                          #   first one.

# Monitor the complete eligible F&O universe. The durable exclusion list, managed
# in Controls → Universe, decides which names can NEVER enter; it does not stop
# monitoring, opportunity publication, or exits for existing exposure. Do not use
# this count to choose one entry — the one-box ceilings above perform that containment.
#
# IMPORTANT: monitoring every name does not create a safe automatic "most liquid"
# selector. The engine requires fresh, executable one-lot depth on all four legs,
# but it will not infer that one stock is the preferred live target. To guarantee
# that only the screened liquid underlying can enter, add every other name to the
# durable exclusion list before arming; excluded names remain observable and cannot
# consume the one attempt.
BOX_MAX_UNDERLYINGS=0                     # 0 = no cap: all non-excluded names.
BOX_STRIKE_LEVEL=1                        # ATM ±1 (clamped to 1|2|3)
# One-direction only for this test. Do not double the candidate set with short
# boxes while proving the one-box live envelope.
BOX_ENABLE_SHORT_BOX=false


# ── 4. ONE LOT — PIN THE CAP TO THE ONLY UNDERLYING ALLOWED TO ENTER ─────────
# ⚠ Edit BOTH lines to the *current* lot of the single, deliberately screened
#   liquid underlying which remains entry-allowed. Do NOT raise them to a large
#   round number "to be safe": these two ceilings are the last defence against a
#   size mistake, and a global raise disables that defence for every future run.
#
# Other monitored names must be excluded from entry through Controls → Universe.
# A different lot size then produces a cheap refusal before any broker order, but
# it is better to prevent the candidate altogether than rely on a cap refusal.
#
#   Instrument   one lot   4-leg gross (= 4 × lot)
#   ──────────   ───────   ───────────────────────
#   NIFTY            75            300
#   BANKNIFTY        35            140
#   RELIANCE        500           2000   ← exceeds the shipped per-leg default of 100
#
# Values below are an EXAMPLE for a one-lot NIFTY box. They must be changed to the
# current lot for your allowed liquid underlying before the live restart.
# exactly one lot
BOX_LIVE_MAX_OPEN_LEG_QUANTITY=75
# exactly four legs of one lot
BOX_LIVE_MAX_GROSS_OPEN_LEG_QUANTITY=300
#
# WHY GROSS MUST BE ≥ 4 × LOT. The whole four-leg envelope is now checked BEFORE
# the first leg posts. Setting gross below 4 × lot does not "cap the box smaller" —
# it makes the attempt IMPOSSIBLE, and the refusal names this variable. Previously
# the gross cap was only checked incrementally per leg, so a too-small value let
# legs 1-2 reach the broker and refused leg 3 — acquiring real hedge exposure
# against a cap the attempt could never satisfy. That is the failure this pairing
# prevents; keep the two numbers consistent.


# ── 5. FUNDING GATES — ALL ARMED ─────────────────────────────────────────────
# All three default to FALSE in code. All three are ON here. When on, MISSING or
# STALE evidence REFUSES the entry rather than assuming the account can bear it.
BOX_LIVE_REQUIRE_FUNDS_COVER=true
BOX_LIVE_REQUIRE_MARGIN_EVIDENCE=true
BOX_LIVE_REQUIRE_STAGE_FUNDING=true
#
# WHY ALL THREE, AND WHY STAGE FUNDING IS NOT REDUNDANT. For Zerodha the basket
# margin's headline total is the FINAL figure — the margin AFTER the spread benefit
# of a completed box. That is the cheapest moment in the whole sequence. Zerodha's
# own documented example shows initial ₹96,504.98 against final ₹34,786.73. So
# MARGIN_EVIDENCE alone can be satisfied by a number less than a third of what the
# intermediate legging window actually requires. STAGE_FUNDING is what forces the
# initial/final split to be kept apart and every stage of the real hedge-first
# sequence to have an establishable requirement.
#
# STAGE_FUNDING STRUCTURALLY IMPLIES FUNDS_COVER. Asking for the stage model is
# asking to be held to it, so the funds comparison runs even if FUNDS_COVER were
# left false — the previously-possible combination "strictest-looking config that
# never checks whether the account can pay" is closed by construction.

BOX_LIVE_FUNDS_FRESHNESS_MAX_AGE_MS=5000
BOX_LIVE_MARGIN_FRESHNESS_MAX_AGE_MS=5000
BOX_LIVE_EVIDENCE_READ_TIMEOUT_MS=2500    # a stalled broker endpoint cannot hold
                                          #   an admission decision open
BOX_LIVE_EVIDENCE_CONCURRENT_READS=false  # serial: the broker's rate limiter is the
                                          #   authority on whether overlap is safe

# Dashboard-only account-margin snapshot. For Zerodha the UI labels
# `available.live_balance` as "Available margin to trade" and shows utilised
# debits separately; it is not cash, total equity, or proof that this four-leg
# basket passes the stricter planned-margin/stage-funding gates above.
BOX_ACCOUNT_FUNDS_ENABLED=true
BOX_ACCOUNT_FUNDS_REFRESH_MS=15000
BOX_ACCOUNT_FUNDS_MAX_AGE_MS=45000

# ── 6. CAPITAL CAP AND RECOVERY RESERVE — ⚠ 0 MEANS DISABLED ─────────────────
# Both default to 0, and at every enforcement site 0 means "no opinion":
#   · BOX_LIVE_MAX_BOX_CAPITAL_RUPEES=0 disables the per-box cap ENTIRELY (it does
#     not even inspect whether the notional could be computed).
#   · BOX_LIVE_RECOVERY_RESERVE_RUPEES=0 holds nothing back, so an entry may
#     consume every available rupee and leave nothing to fund the cancel/unwind
#     that recovers it. Zero produces only an advisory sentence, never a refusal.
#
# A configuration with both at 0 is therefore UNCAPPED and UNRESERVED. Set both.
# The cap is GROSS OPTION-ORDER NOTIONAL — not margin, not peak exposure, not max
# loss. Size it against the four bounded LIMIT orders you are about to send.
# EDIT: your approved gross-notional cap
BOX_LIVE_MAX_BOX_CAPITAL_RUPEES=100000
# EDIT: rupees withheld for recovery
BOX_LIVE_RECOVERY_RESERVE_RUPEES=25000


# ── 7. MARKET-DATA FRESHNESS AND FOUR-LEG COHERENCE ──────────────────────────
# PRESERVED AT THE VALUES THE DEPLOYMENT IS ALREADY RUNNING. Do not retune these
# for the live attempt: the market-data posture is the one thing that should NOT
# change between the paper run that built confidence and the live attempt.
BOX_QUOTE_MAX_AGE_MS=15000                # per-leg book age
BOX_FEED_MAX_AGE_MS=5000                  # whole-universe feed liveness
BOX_MAX_CROSS_LEG_RECEIVE_DISPERSION_MS=500    # PRIMARY live coherence gate
BOX_MAX_CROSS_LEG_EXCHANGE_DISPERSION_MS=1000  # was 250 — see below
BOX_MAX_RECEIVE_TO_EXCHANGE_DELAY_MS=5000
BOX_COHERENCE_ZERO_DISPERSION_DISABLES_IN_LIVE=false   # in LIVE, 0 is
                                          #   impossible-to-satisfy, NOT a bypass
#
# ⚠ PRECISION TRAP ON EXCHANGE DISPERSION — NOW CONFIRMED IN PRACTICE, NOT THEORY.
#   Kite's order-book timestamp is whole-SECOND granular, so any limit below
#   1000 ms rejects four genuinely coherent books on quantisation alone. This
#   template previously shipped 250 and said "the attempt may simply never be
#   admitted". It never was: a paper_legging run on a healthy 200-underlying feed
#   refused 100% of attempts, every one `cross_leg_time_skew`, with the detail
#   `exchange-timestamp dispersion 1000ms exceeds 250ms` — four legs straddling a
#   second boundary, which is most of them.
#
#   1000 is now set, matching deploy/mumbai-ec2-conservative.env.example and the
#   code default. It is still a real check: stamps genuinely separated (15s/18s/
#   15s/19s = 4000 ms) are still refused. The RECEIVE-time gate above (500 ms) is
#   the primary and precise one — it uses our own millisecond arrival clock and is
#   unaffected by exchange-stamp granularity.
#
#   The error direction of a too-low value is SAFE (it refuses, never admits an
#   incoherent box) — but "safe" and "able to trade" are different properties, and
#   a supervised attempt that can never be admitted proves nothing.


# ── 8. ORDER-UPDATE STREAM ───────────────────────────────────────────────────
# Zerodha order updates arrive as TEXT frames on the existing box quote socket;
# there is no separate order socket to open. This flag decides whether they are
# CONSUMED.
ZERODHA_ORDER_STREAM_ENABLED=false
#
# ⚠ COUNTER-INTUITIVE, READ BEFORE FLIPPING. `false` (DISABLED) is the PERMISSIVE
#   setting for entry: REST polling is the documented baseline, so a disabled
#   stream does not block new entry — it only makes fill observation slower.
#   ARMING it makes entry STRICTER, because a CONNECTING / RECONCILING / DEGRADED /
#   DISCONNECTED stream then REFUSES new entry.
#
#   Either choice is defensible for a supervised attempt with a human watching:
#     · false — the attempt is not hostage to stream health; fills are observed by
#               REST reconciliation, which remains the authority in both cases and
#               cannot double-count against the stream.
#     · true  — slower-to-fail is traded for faster fill visibility, and a
#               half-connected stream will refuse the attempt outright.
#   What is NOT defensible is arming it and then reading a `DEGRADED` refusal as a
#   fault. Decide once, before the window.


# ── 9. ECONOMIC GATE AND ONE-FAILURE BREAKERS ───────────────────────────────
# expected net profit after every cost
BOX_MIN_EXPECTED_NET_PROFIT=1200
BOX_REQUIRE_PRICED_CHARGES=true           # never admit on unpriced charges
# A one-attempt session should never keep operating after any unexpected broker
# reject or technical failure. The durable attempt cap is still the hard bound;
# these sticky breakers make the stop condition visible and require inspection.
BOX_LIVE_REJECT_LIMIT=1
BOX_LIVE_CONSECUTIVE_FAILURE_LIMIT=1
# EDIT: maximum realised rupee loss you explicitly accept for this trial. This
# is a backstop, not sizing: the broker basket/stage margin and exact lot still
# decide whether entry is affordable.
BOX_LIVE_DAILY_LOSS_LIMIT=5000


# ── 10. PRE-ATTEMPT CHECKLIST (all must be confirmed, in order) ──────────────
#  1. `node dist/box/effectiveConfig.js` shows the ceilings above as EFFECTIVE.
#  2. PostgreSQL is connected and migrations are applied — including
#     `011_order_intent_broker_account.sql`, which adds the `broker_account`
#     column every live intent is now stamped with. Without it, live order
#     persistence fails.
#  3. Zerodha is signed in AND the status endpoint reports the account as present
#     (`identity.account_present: true`, `account_masked` non-null). If the account
#     cannot be named, live entry is refused — and it will read as "the broker
#     account could not be identified", NOT as a token problem. Re-login through
#     the in-app flow is what populates it.
#  4. Static IP: confirmed out-of-band against the API key. `static_ip_configured`
#     is `null` for Zerodha, which means NOT MODELLED — it does not mean not
#     required. The SEBI mandate applies; this deployment does not gate on it.
#  5. Market data READY with ticks observed (`ticks_observed: true`, not merely a
#     connected socket), and the universe non-empty.
#  6. `reconciliation_complete: true`, zero unknown orders, breaker closed, no
#     residual legs, recovery not active.
#  7. A fresh session ARMED with both ceilings, verified as in §2.
#  8. An operator is watching the position and P&L surfaces, with the abort
#     procedure below open in front of them.
#
# ── ABORT PROCEDURE ──────────────────────────────────────────────────────────
# Exposure reduction is INDEPENDENT of the entry controls. Turning entry off does
# NOT disable getting flat — that inversion was a real defect and is now fixed and
# regression-tested. In order of escalation:
#   1. Disarm the session               → no further attempt is admitted.
#   2. box_entry_enabled = false        → no NEW exposure. Cancel, exit and
#                                         attributed reduction all continue.
#   3. Cancel working orders            → returns an explicit result. A refusal is
#                                         409 with a reason and a partial sweep is
#                                         207 with per-order failures; it can no
#                                         longer report an empty success.
#   4. Exit / flatten the attributed box position.
#   5. Revert BOX_EXECUTION_MODE to paper_latency and restart.
# ═════════════════════════════════════════════════════════════════════════════
