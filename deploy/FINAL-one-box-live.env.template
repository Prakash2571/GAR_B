# ═════════════════════════════════════════════════════════════════════════════════════════════
# THE FINAL ONE-BOX LIVE ENV — everything in one file, ready to copy.
#
# ONE box. ONE underlying. ONE lot per leg. Four legs submitted concurrently within each
# hedge wave. Under continuous human supervision.
#
# This supersedes nothing: deploy/supervised-live-test.env.template remains the annotated
# reference and deploy/one-box-live-4leg.env.template explains the three traps in detail. This
# file is the consolidated, copy-paste version of both.
#
# ─────────────────────────────────────────────────────────────────────────────────────────────
# BEFORE YOU COPY — FOUR VALUES YOU MUST EDIT, MARKED «EDIT» BELOW
#
#   The quantity and capital ceilings below are sized for NIFTY (lot 75). They will REFUSE a
#   single-stock box outright, because a stock lot is much larger — PAYTM is 725, so a
#   per-leg cap of 75 refuses it before the first order. If you trade anything other than
#   NIFTY you MUST change all four. Getting this wrong looks like "nothing ever trades".
#
# AFTER YOU COPY — VERIFY, DO NOT ASSUME
#
#     node dist/box/effectiveConfig.js
#
#   The integer loader silently turns a blank, an unparseable value or a negative into the
#   DEFAULT. For both session ceilings that default is 0 = UNLIMITED. So
#   BOX_SESSION_MAX_ENTRY_ATTEMPTS=one and =-1 both mean UNLIMITED ATTEMPTS. Read the
#   effective-config output; do not eyeball this file.
# ═════════════════════════════════════════════════════════════════════════════════════════════


# ── 0. YOUR EXISTING INFRASTRUCTURE — DO NOT COPY OVER THESE ─────────────────────────────────
# Keep whatever your deployment already has. Nothing below replaces them, and none of them
# belong in a file that gets committed:
#   DATABASE_URL, MONGODB_URI, SESSION_SECRET, SITE_PASSCODE_HASH, CSRF_ALLOWED_ORIGIN,
#   BROKER_TOKEN_ENCRYPTION_KEY, ZERODHA_API_KEY / _SECRET, DHAN_* credentials,
#   CALSPREAD_DEPLOYMENT_ID, CALSPREAD_INSTANCE_ID, APP_TIMEZONE, DEFAULT_ACTIVE_BROKER
#
# ⚠ POSTGRESQL MUST BE CONNECTED. Without it the entire session-budget layer is INERT — both
#   ceilings below count nothing. Confirm `db_enabled: true` on /api/box/status first.


# ── 1. GO LIVE (three independent switches, all required) ────────────────────────────────────
BOX_EXECUTION_MODE=live
BOX_LIVE_TRADING_ENABLED=true
ZERODHA_LIVE_TRADING_ENABLED=true

# Mutually exclusive with live; stated so a copy-paste cannot re-enable them and fail at boot.
BOX_SHADOW_MODE_ENABLED=false
BOX_PAPER_EXECUTION_PROFILE=standard


# ── 2. ONLY ONE BOX — FIVE CONTROLS, FIVE DIFFERENT HOLES ───────────────────────────────────
#
# BOX_MAX_OPEN_BOXES is the one that actually answers "I cannot afford a second box". It is
# the only global ceiling enforced in EVERY execution mode and decided BEFORE any exposure
# exists, and it counts committed exposure — open positions, unresolved partial entries,
# unreconciled orders, in-flight entry pipelines and reservations held over an uncertain
# outcome. At 1, a second box is refused on ANY underlying, in EITHER direction.
BOX_MAX_OPEN_BOXES=1

# Bounds what you TRY, not what you hold. An attempt that posted orders, partially filled and
# was unwound took real exposure and paid real charges, and holds no inventory afterwards — so
# only this catches it. It is ALSO the only thing that refuses two entries admitted in the
# same instant on DIFFERENT underlyings. Do not raise it "to allow a retry".
BOX_SESSION_MAX_ENTRY_ATTEMPTS=1
BOX_SESSION_MAX_COMPLETED_TRADES=1

# Refuses a second box on the same underlying regardless of strike pair, expiry or direction.
# The code default is false — deliberately ON here.
BOX_ONE_ACTIVE_BOX_PER_UNDERLYING=true
BOX_MAX_CONCURRENT_PER_UNDERLYING=1

# ⚠ 0 does NOT mean unlimited here — the guard is `openBoxes >= limit`, so 0 means NO box may
#   ever open. Note this one is LIVE-ONLY and is read from a count refreshed only after a
#   position exists, which is why BOX_MAX_OPEN_BOXES above exists.
BOX_LIVE_MAX_OPEN_BOXES=1
BOX_LIVE_MAX_CONCURRENT_EXECUTIONS=1

# ⚠ the comparison is STRICTLY GREATER, so 0 tolerates no residual leg at all.
BOX_LIVE_MAX_RESIDUAL_LEGS=0


# ── 3. THE FOUR-LEG BURST ───────────────────────────────────────────────────────────────────
# 4 = let both legs of a hedge wave travel together. It does NOT mean four simultaneous
# orders: entry is hedge-first in two waves (2 BUYs, then the 2 uncovered SELLs held until the
# hedges have attributed fill proof), and concurrency cannot overlap a SELL with its hedge.
# The gap between placements remains a real rate-limit wait — Zerodha 110 ms, floor 100 ms.
BOX_LIVE_ENTRY_SUBMIT_CONCURRENCY=4
BOX_LIVE_BROKER_ORDER_MIN_INTERVAL_MS=0
BOX_LIVE_BROKER_MIN_INTERVAL_MS=250


# ── 4. THE UNIVERSE ─────────────────────────────────────────────────────────────────────────
# BOX_MAX_UNDERLYINGS caps HOW MANY names are considered, chosen by the board's own priority
# order (indices first, then alphabetical) — you do not choose WHICH. At 1 you get NIFTY,
# which is why the quantity ceilings in §5 are sized for a 75 lot.
#
# To choose BY NAME, use the operator blocklist (no restart, any time):
#     GET    /api/box/excluded-underlyings
#     POST   /api/box/excluded-underlyings   {"symbol":"NYKAA","reason":"illiquid strikes"}
#     DELETE /api/box/excluded-underlyings/NYKAA
BOX_MAX_UNDERLYINGS=1
BOX_STRIKE_LEVEL=1
BOX_ENABLE_SHORT_BOX=false


# ── 5. «EDIT» QUANTITY AND CAPITAL — SIZED FOR NIFTY (LOT 75) ───────────────────────────────
#
#   BOX_LIVE_MAX_OPEN_LEG_QUANTITY       = the one-lot quantity of YOUR chosen instrument
#   BOX_LIVE_MAX_GROSS_OPEN_LEG_QUANTITY = 4 x that
#   BOX_LIVE_MAX_BOX_CAPITAL_RUPEES      = comfortably above the box's GROSS ORDER NOTIONAL
#                                          (not broker margin — see boxCapital.ts)
#   BOX_LIVE_RECOVERY_RESERVE_RUPEES     = ~25% of the above, kept back for an unwind
#
#   NIFTY 75 → 75 / 300. PAYTM 725 → 725 / 2900. Set the per-leg cap to the instrument's own
#   lot; do NOT raise it globally "to be safe" — it is the barrier that stops a 500-unit stock
#   lot being half-executed.
BOX_LIVE_MAX_OPEN_LEG_QUANTITY=75
BOX_LIVE_MAX_GROSS_OPEN_LEG_QUANTITY=300
BOX_LIVE_MAX_BOX_CAPITAL_RUPEES=100000
BOX_LIVE_RECOVERY_RESERVE_RUPEES=25000


# ── 6. FUNDING ADMISSION — ALL ARMED ────────────────────────────────────────────────────────
# With these on, MISSING or STALE broker evidence REFUSES the entry rather than assuming.
BOX_LIVE_REQUIRE_FUNDS_COVER=true
BOX_LIVE_REQUIRE_MARGIN_EVIDENCE=true
BOX_LIVE_REQUIRE_STAGE_FUNDING=true
BOX_LIVE_FUNDS_FRESHNESS_MAX_AGE_MS=5000
BOX_LIVE_MARGIN_FRESHNESS_MAX_AGE_MS=5000
BOX_LIVE_EVIDENCE_READ_TIMEOUT_MS=2500
BOX_LIVE_EVIDENCE_CONCURRENT_READS=false


# ── 7. FRESHNESS AND FOUR-LEG COHERENCE ─────────────────────────────────────────────────────
BOX_QUOTE_MAX_AGE_MS=15000
BOX_FEED_MAX_AGE_MS=5000
BOX_MAX_CROSS_LEG_RECEIVE_DISPERSION_MS=500
BOX_MAX_CROSS_LEG_EXCHANGE_DISPERSION_MS=250
BOX_MAX_RECEIVE_TO_EXCHANGE_DELAY_MS=5000
BOX_COHERENCE_ZERO_DISPERSION_DISABLES_IN_LIVE=false


# ── 8. ECONOMICS ────────────────────────────────────────────────────────────────────────────
BOX_MIN_EXPECTED_NET_PROFIT=1200
BOX_REQUIRE_PRICED_CHARGES=true


# ── 9. ORDER STREAM ─────────────────────────────────────────────────────────────────────────
# Off for a first supervised run: REST reconciliation is the proven path, and the stream adds
# a second moving part on the day you least want one.
ZERODHA_ORDER_STREAM_ENABLED=false


# ═════════════════════════════════════════════════════════════════════════════════════════════
# ON THE DAY — every step is a separate, deliberate action
#
#   1. Apply migrations. Confirm 012 applied.
#   2. Boot. On /api/box/status confirm:
#        execution_mode "live" · db_enabled true · reconciliation_complete true
#        unknown_orders 0 · excluded_underlyings.readable true
#        operational_readiness.blockers — clear EVERY entry-scoped one
#   3. Confirm the broker session is the account you expect.
#   4. Set the blocklist for the day.
#   5. Arm, in this order, so the panic button is live before anything can be sent:
#        live orders → emergency flatten → entry
#   6. Arm the session explicitly and CHECK the response:
#        POST /api/box/session/arm { "max_completed_trades": 1, "max_entry_attempts": 1 }
#      Confirm it reports max_entry_attempts 1 and remaining_entry_attempts 1. Both ceilings
#      are SNAPSHOTTED at arm time — editing this file and restarting does NOT rebind a
#      session that is already armed.
#   7. RUN the scanner.
#
# ⚠ HAVE THESE OPEN IN A TERMINAL BEFORE YOU ARM. If the websocket drops while the box is
#   open, NO EXIT IS ATTEMPTED — the monitor requires a healthy feed, there is no REST
#   fallback on the exit path, and expiry-safety is checked after the same gate. Getting flat
#   with a dead feed is an operator action:
#        POST /api/box/live/cancel-working
#        POST /api/box/live/flatten
#
# AFTER IT GOES FLAT — nothing stops by itself in this build:
#        POST /api/box/stop
#        POST /api/box/session/disarm
#        GET  /api/box/trades/history?scope=today     the numbers
#        GET  /api/box/events?limit=200               the decision trail
#        GET  /api/box/execution-attempts             anything attempted and aborted
#   `exit_charge_reconciliation` starts `pending`; fees read immediately after flat are LOCAL
#   estimates. Wait for it to settle before treating them as final.
# ═════════════════════════════════════════════════════════════════════════════════════════════
