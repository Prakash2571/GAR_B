DHAN_LIVE_TRADING_ENABLED=false


# ═══ §7. MONGODB — ASYNCHRONOUS REPORTING REPLICA, OPTIONAL ══════════════════════════════════
MONGO_EXPORT_ENABLED=false
MONGODB_URI=
MONGO_EXPORT_DB=
MONGO_EXPORT_BATCH_SIZE=100
MONGO_EXPORT_INTERVAL_MS=1000
MONGO_EXPORT_MAX_BACKOFF_MS=60000
MONGO_EXPORT_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_EXPORT_MAX_ATTEMPTS=10
LEGACY_BOX_MONGODB_URI=


# ═══ §8. GO LIVE — THREE SWITCHES. START IN PAPER. ═══════════════════════════════════════════
#
# START HERE, NOT LIVE. Run a full session in paper_legging, read the funnel, tune §15, and only
# then change these three lines. paper_legging exercises the same per-leg execution path as live,
# so the rehearsal is evidence about the thing you are about to do.
#
#   FIRST SESSIONS (as shipped):
BOX_EXECUTION_MODE=paper_legging
BOX_LIVE_TRADING_ENABLED=false
ZERODHA_LIVE_TRADING_ENABLED=false
#
#   GOING LIVE — replace the three lines above with:
#     BOX_EXECUTION_MODE=live
#     BOX_LIVE_TRADING_ENABLED=true
#     ZERODHA_LIVE_TRADING_ENABLED=true

BOX_SHADOW_MODE_ENABLED=false
BOX_PAPER_EXECUTION_PROFILE=live_parity


# ═══ §9. ONLY ONE BOX ════════════════════════════════════════════════════════════════════════
#
# TWO DIFFERENT MEANINGS OF "ONLY ONE BOX" — CHOOSE DELIBERATELY.
#
#   (A) ONE AT A TIME, all day. One box of inventory; when it closes, the engine may take
#       another. This is what "watch 150 stocks for arbitrage" normally wants.
#   (B) ONE FOR THE WHOLE SESSION, then stop. A hard one-shot: after a single ENTRY ATTEMPT —
#       even one that was rejected or unwound — no further entry is taken until re-armed.
#
# As shipped this file is (B), the supervised one-shot, because it is the first live run. That is
# BOX_SUPERVISED_ONE_LOT_TRIAL=true, which REFUSES STARTUP unless all four of the settings it
# pins are exactly 1 — so it cannot be half-applied.
#
# NOTE: if your current .env already has BOX_SESSION_MAX_ENTRY_ATTEMPTS=1 you are in (B) today.
# That alone will look like "the engine stopped finding opportunities" after the first attempt.
#
#   (B) SUPERVISED ONE-SHOT — as shipped:
BOX_SUPERVISED_ONE_LOT_TRIAL=true
BOX_SESSION_MAX_ENTRY_ATTEMPTS=1
BOX_SESSION_MAX_COMPLETED_TRADES=1
#
#   (A) ONE AT A TIME, CONTINUOUS — once a first box has opened, filled and exited cleanly,
#       replace the three lines above with (0 = no session bound; the inventory ceilings below
#       are what keep you to one box at a time):
#     BOX_SUPERVISED_ONE_LOT_TRIAL=false
#     BOX_SESSION_MAX_ENTRY_ATTEMPTS=0
#     BOX_SESSION_MAX_COMPLETED_TRADES=0

# The inventory ceilings. These are what actually enforce "one box at a time" in BOTH modes, and
# they count in-flight entry claims — not just settled positions — so two candidates admitted in
# the same instant cannot both proceed.
BOX_MAX_OPEN_BOXES=1
BOX_LIVE_MAX_OPEN_BOXES=1
BOX_MAX_CONCURRENT_EXECUTIONS=1
BOX_LIVE_MAX_CONCURRENT_EXECUTIONS=1

# One box per underlying, so the single slot cannot be spent twice on the same name.
BOX_ONE_ACTIVE_BOX_PER_UNDERLYING=true
BOX_MAX_CONCURRENT_PER_UNDERLYING=1

# No partially-open box may be left standing.
BOX_LIVE_MAX_RESIDUAL_LEGS=0
BOX_LIVE_RECOVERY_ESCALATION_MS=120000

BOX_EXECUTION_COORDINATOR_ENABLED=true
BOX_DURABLE_RESERVATIONS_ENABLED=true
BOX_INTERNAL_NETTING_ENABLED=false


# ═══ §10. THE FOUR-LEG BURST — DELIBERATELY SERIAL ═══════════════════════════════════════════
# One leg in flight at a time, 250ms apart. Slower fills, but a rejection is unambiguous and the
# unwind path is simple. Revisit only after the first clean live boxes.
BOX_LIVE_ENTRY_SUBMIT_CONCURRENCY=1
BOX_LIVE_BROKER_ORDER_MIN_INTERVAL_MS=0
BOX_LIVE_BROKER_MIN_INTERVAL_MS=250


# ═══ §11. THE UNIVERSE — 150 STOCKS AT ATM±1 ═════════════════════════════════════════════════
#
# THE ONE LINE THAT DECIDES WHETHER YOU WATCH STOCKS AT ALL. Default is false, and false deletes
# every non-index chain from the universe during refresh. There is no warning that says "you
# asked for 150 stocks and got 0".
BOX_ALLOW_STOCK_UNDERLYINGS=true

# 150 names. Applied as a cut over a FIXED order (indices first, then stocks alphabetically) with
# no rotation — so the same names win every refresh. Names beyond the cut appear in the status
# payload as `skipped_for_underlying_cap`, and in GET /api/box/universe as
# `not_watched_reason: underlying_cap`. Indices sort FIRST, so roughly the first 4-6 slots go to
# indices; exclude them via POST /api/box/excluded-underlyings/bulk if you want all 150 to be
# stocks. (They are harmless otherwise — no index can clear the per-unit gate in §15.)
BOX_MAX_UNDERLYINGS=150

# ATM±1 — YOUR CHOICE, and the liquid one: 3 strikes, so C(3,2) = 3 strike pairs per underlying,
# and with SHORT boxes off that is 3 candidates per name, 450 across the universe.
BOX_STRIKE_LEVEL=1

# LONG BOX ONLY, as requested. Halves the candidate set and keeps the direction unambiguous.
BOX_ENABLE_SHORT_BOX=false

# TOKEN BUDGET — the arithmetic that makes 150 names actually stream.
# At ATM±1 a window is 3 strikes = 3 CE + 3 PE + 1 spot = 7 tokens. 150 × 7 = 1,050.
# 1,600 leaves headroom for open-position tokens, which are subscribed outside the budget.
# Set this too low and the tail of the universe silently never ticks (`skipped_for_budget`).
BOX_MAX_SUBSCRIBED_TOKENS=1600
BOX_INDICATIVE_MAX_UNDERLYINGS=150
BOX_INDICATIVE_DISCOVERY=true

# Expiry distance. Stock options are MONTHLY only, so in the last few sessions of a monthly cycle
# every stock rolls to the next series, where the books are much thinner — expect a recurring
# quiet stretch around the roll rather than a fault.
BOX_MIN_TRADING_DAYS_TO_EXPIRY=2
BOX_STOCK_MIN_TRADING_DAYS_TO_EXPIRY=5
BOX_EXPIRY_SAFETY_MINUTES=45


# ═══ §11b. THE LIVE ENTRY ALLOWLIST — LEAVE IT EMPTY ═════════════════════════════════════════
# EMPTY means "no identity restriction", which is required here. This is an ENTRY filter, not a
# discovery filter: set to a name (the shipped index template sets NIFTY) it refuses entry on
# every other underlying while still happily showing you their opportunities.
# To restrict by identity instead, list the exact symbols, comma-separated.
BOX_LIVE_ALLOWED_UNDERLYINGS=


# ═══ §11c. «EDIT» ZERODHA STATIC IP ══════════════════════════════════════════════════════════
# Zerodha requires order placement from a registered static address. This flag is YOUR
# confirmation that the registration is done — GAR_B cannot ask Zerodha to verify it.
#
# FAIL-CLOSED AND EASY TO MISS: unset, blank or unrecognised all read as NOT confirmed, and the
# effect is that NO NEW LIVE ENTRY is ever taken. Exits, protective cancels, residual flattening
# and reconciliation are deliberately NOT gated by it.
ZERODHA_STATIC_IP_CONFIRMED=false
ZERODHA_EXPECTED_EGRESS_IP=


# ═══ §12. «EDIT» QUANTITY AND CAPITAL — SIZED FOR STOCK LOTS ═════════════════════════════════
#
# Exactly one exchange lot per leg, so leg quantity IS the lot size and varies by name.
BOX_LIVE_EXACT_ONE_LOT=true
BOX_LIVE_MAX_LOTS_PER_LEG=1

# ONE GLOBAL NUMBER ACROSS ~150 DIFFERENT LOT SIZES. Set it to the largest lot you are willing to
# trade, then exclude anything above it — the cap and the blocklist then agree instead of a name
# being silently unable to trade. A name whose lot exceeds this is not merely unlikely to trade;
# it CANNOT, ever, and GET /api/box/universe reports it as `lot_exceeds_per_leg_cap`.
BOX_LIVE_MAX_OPEN_LEG_QUANTITY=50000
BOX_LIVE_MAX_GROSS_OPEN_LEG_QUANTITY=200000

# With the per-leg cap deliberately generous, THIS is the real economic bound on one box.
# A long box costs about `boxWidth × lotSize`, so at ATM±1 on a ₹5-step stock with a 20,000 lot
# the widest pair is ₹10 wide → ₹200,000. Size it to what you will fund, not to what fits.
BOX_LIVE_MAX_BOX_CAPITAL_RUPEES=400000
BOX_LIVE_RECOVERY_RESERVE_RUPEES=25000


# ═══ §13. FUNDING ADMISSION — ALL ARMED ══════════════════════════════════════════════════════
# All four default OFF in code. Setting them is what makes funding VERIFIED rather than unchecked.
BOX_LIVE_REQUIRE_FUNDS_COVER=true
BOX_LIVE_REQUIRE_MARGIN_EVIDENCE=true
BOX_LIVE_REQUIRE_STAGE_FUNDING=true
BOX_LIVE_FUNDS_FRESHNESS_MAX_AGE_MS=5000
BOX_LIVE_MARGIN_FRESHNESS_MAX_AGE_MS=5000
BOX_LIVE_EVIDENCE_READ_TIMEOUT_MS=2500
BOX_LIVE_EVIDENCE_CONCURRENT_READS=false


# ═══ §14. FRESHNESS AND FOUR-LEG COHERENCE ═══════════════════════════════════════════════════
# Stock option books update far less often than an index book. 3,000ms is already strict for the
# quieter names; if §15 is clearly reachable but nothing is ever `tradable`, check the scanner's
# `rejectedStale` counter before loosening anything else.
BOX_QUOTE_MAX_AGE_MS=3000
BOX_FEED_MAX_AGE_MS=5000
BOX_UNDERLYING_MAX_AGE_MS=10000

# All four legs must describe the same moment.
BOX_MAX_CROSS_LEG_RECEIVE_DISPERSION_MS=500
BOX_MAX_CROSS_LEG_EXCHANGE_DISPERSION_MS=1000
BOX_MAX_RECEIVE_TO_EXCHANGE_DELAY_MS=5000
BOX_COHERENCE_ZERO_DISPERSION_DISABLES_IN_LIVE=false


# ═══ §15. ENTRY ECONOMICS — LOT-RELATIVE. THE POINT OF THIS PROFILE. ═════════════════════════
#
# Each pair below is `flat` + `per unit`, resolved per candidate as:
#
#     effective = max(flat, perUnit × lotSize)
#
# The FLAT figure is an absolute floor — the smallest ticket worth an execution at all. The RATE
# is the real economic hurdle. Setting only the flat figure is the old behaviour, and across a
# mixed universe that is the bug described in the header.
#
# WHAT THESE NUMBERS ASSUME (so you can argue with them):
#   * NSE stock option tick = ₹0.05.
#   * Fixed charges ≈ ₹190 per box round trip (8 orders × ₹20 + GST) → ₹190/lotSize per unit.
#   * Proportional charges ≈ ₹0.10/unit (STT 0.15% on sold premium, exchange txn, GST).
#   * Adverse movement between detection and fill ≈ 2 ticks spread over the legs → ₹0.10/unit
#     each way. Crossing the spread is NOT in this figure; the touch price already includes it.
#
# Required gross edge therefore works out at roughly:
#     0.25 (target) + 0.05 (buffer) + 0.10 + 0.10 (slippage) + 0.10 (charges) + 190/lotSize
#   ≈ ₹0.62/unit on a 10,000 lot   (₹2,500 expected net profit on the box)
#   ≈ ₹0.70/unit on a  2,000 lot
#
# TUNING, IN ORDER:
#   1. Run paper_legging for a session. GET /api/box/status → scanner counters.
#   2. `rejectedNetProfit` dominant  -> the gate is above the real market. Lower the RATE first.
#   3. `rejectedLiquidity` dominant  -> the touch cannot fill a whole lot on 4 legs. Lower
#      BOX_LIVE_MAX_OPEN_LEG_QUANTITY and exclude the biggest-lot names; the edge is not real.
#   4. `rejectedStale` dominant      -> §14 freshness, or names too illiquid to watch.
#   5. Only widen the universe or loosen §14 after the rates are honest.

# THE ENTRY GATE.
BOX_MIN_EXPECTED_NET_PROFIT=400
BOX_MIN_EXPECTED_NET_PROFIT_PER_UNIT=0.25

# The cheap gross prefilter. Held at or below the gate at startup — above it, it would discard
# candidates that would have qualified. Never the decision.
MIN_BOX_GROSS_EDGE=400
MIN_BOX_GROSS_EDGE_PER_UNIT=0.25
MIN_BOX_NET_EDGE=0

# Risk allowance, deducted inside the expected-net figure.
BOX_SAFETY_BUFFER=50
BOX_SAFETY_BUFFER_PER_UNIT=0.05

# Slippage. These are the figures a flat rupee amount got most wrong: slippage is ticks ×
# QUANTITY, so a flat ₹250 understates the cost on a 40,000 lot by ~99% — making exactly the
# names it most readily admitted look more profitable than they were.
BOX_EXPECTED_ENTRY_SLIPPAGE=50
BOX_EXPECTED_ENTRY_SLIPPAGE_PER_UNIT=0.10
BOX_EXPECTED_EXIT_SLIPPAGE=50
BOX_EXPECTED_EXIT_SLIPPAGE_PER_UNIT=0.10

# Voluntary take-profit floor, scaled for the same reason and for CONSISTENCY WITH ENTRY: if the
# entry gate is lot-relative and this is flat, a large-lot box is entered against a real hurdle
# and then released against a trivial one. Never an exit PERMISSION — expiry-safety exits, manual
# closes, protective cancels and emergency flattening all ignore it.
BOX_MIN_EXIT_NET_PNL=200
BOX_MIN_EXIT_NET_PNL_PER_UNIT=0.12

# Never enter a box whose charges could not be priced.
BOX_REQUIRE_PRICED_CHARGES=true


# ═══ §15b. CIRCUIT BREAKERS — SET EXPLICITLY ═════════════════════════════════════════════════
BOX_LIVE_DAILY_LOSS_LIMIT=5000
BOX_LIVE_REJECT_LIMIT=3
BOX_LIVE_CONSECUTIVE_FAILURE_LIMIT=3


# ═══ §16. ORDER STREAM ═══════════════════════════════════════════════════════════════════════
# Leave false until the postback/websocket order feed has been verified on this deployment.
ZERODHA_ORDER_STREAM_ENABLED=false


