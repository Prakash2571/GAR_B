# =============================================================================
# GTS Algo Research — production .env for gtsalgoresearch.online
#
# Copy to the backend's .env, fill in ONLY the marked <FILL IN> values, restart.
#
#   cp deploy/production.env.template .env && nano .env
#
# ── TWO RULES THAT MATTER MORE THAN ANY VALUE HERE ──────────────────────────
#
# 1. LEAVE A KNOB EMPTY TO USE ITS DEFAULT. NEVER WRITE 0 TO MEAN "DEFAULT".
#    An explicit 0 is a real value and is honoured. Several timing knobs are
#    passed straight to setInterval, where 0 means "run as fast as the event
#    loop allows" — four spin loops at once, which starves the market-data
#    drain and shows up as intermittent 502s. Every optional knob below is
#    therefore either absent or has a real value. Do not add `=0` lines.
#
# 2. EVERY Box strategy knob not listed here is DELIBERATELY OMITTED. The code
#    defaults ARE the shipped specification (src/box/config.ts). Only override
#    one when you have a reason, and then give it a real value.
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
PORT=3001

# `production` only ever TIGHTENS: it requires FRONTEND_URL to be https, because
# the session cookie is Secure-only.
NODE_ENV=production

# MUST be Asia/Kolkata. Every trading-day, token-scheduling and P&L-day decision
# is an IST decision; any other value is rejected at boot.
APP_TIMEZONE=Asia/Kolkata

# The exact origin the browser UI runs on. CORS is exact-origin WITH credentials,
# never a wildcard — a mismatch here makes every API call from the browser fail.
# It is also where the browser is sent after a broker sign-in.
FRONTEND_URL=https://gtsalgoresearch.online

# How long graceful shutdown may take (ms). PM2 kill_timeout must sit above this.
SHUTDOWN_TIMEOUT_MS=20000


# -----------------------------------------------------------------------------
# Site access — the passcode that gates the whole UI
#
# IMPORTANT: this passcode ARMS NOTHING. It lets an operator into the site; it
# does NOT enable live trading. Anyone holding it is a legitimate operator and
# sees the same shared broker session as everyone else.
# -----------------------------------------------------------------------------

# <FILL IN>  Generate with:  openssl rand -base64 48
# FAILS CLOSED: if unset, nobody can get in at all (not "no passcode needed").
# Backend-only. Never sent to the browser, never logged, no VITE_ counterpart.
SITE_ACCESS_SECRET=

SITE_SESSION_TTL_HOURS=24

# Pinning this explicitly is the recommended practice: a future change to the
# code default then cannot log your operators out.
SESSION_COOKIE_NAME=gts_session

# Origin required on mutating requests. Empty = same as FRONTEND_URL. Leave empty.
CSRF_ALLOWED_ORIGIN=


# -----------------------------------------------------------------------------
# PostgreSQL — the single operational authority. NOT optional.
# -----------------------------------------------------------------------------

# <FILL IN>  KEEP YOUR EXISTING VALUE if the backend is already connecting.
# If the password contains @ : / ? # [ ] it MUST be percent-encoded.
#   postgresql://gts:PASSWORD@127.0.0.1:5432/strikedge
DATABASE_URL=

PG_POOL_MAX=10
PG_STATEMENT_TIMEOUT_MS=5000
PG_LOCK_TIMEOUT_MS=2000

# Apply pending migrations during boot. KEEP TRUE unless you run `npm run migrate`
# as an explicit release step — several features fail closed without their tables
# (a missing 009_backend_instance_epoch disables new entry entirely).
PG_MIGRATE_ON_BOOT=true

# Cosmetic label in pg_stat_activity.
PG_APPLICATION_NAME=gts


# -----------------------------------------------------------------------------
# Token encryption — AES-256-GCM for broker tokens at rest
# -----------------------------------------------------------------------------

# <FILL IN>  Generate with:  openssl rand -hex 32
# MUST decode to EXACTLY 32 bytes (64 hex chars, or base64 that decodes to 32).
# If this is missing or wrong, a sign-in appears to succeed but the session
# CANNOT BE SAVED — the card says "a restart will require signing in again", and
# /api/tokens/* answers 409 because it reads the stored row.
# Changing it makes previously sealed tokens unreadable (just sign in again).
BROKER_TOKEN_ENCRYPTION_KEY=


# -----------------------------------------------------------------------------
# Where access tokens come from
#
# in_app   THIS deployment runs the broker login. The token is minted here,
#          sealed with the key above and stored in PostgreSQL, then shared by
#          every browser and served to sibling services. No external service.
# provider Poll the old external CalSpread token route instead (rollback path).
#
# Mutually exclusive on purpose: a poller racing an interactive login can
# overwrite the session an operator just established.
# -----------------------------------------------------------------------------
BROKER_LOGIN_MODE=in_app


# -----------------------------------------------------------------------------
# Zerodha (Kite Connect) app — required for in_app sign-in
#
# On https://developers.kite.trade/apps set the app's Redirect URL to EXACTLY
# the KITE_REDIRECT_URL below. Kite always uses its own registered copy and
# ignores anything we send, so a mismatch is the usual cause of a sign-in that
# never completes. Leave the app's Postback URL EMPTY — Zerodha multiplexes
# order postbacks onto the market-data socket, so no HTTP postback is used.
# -----------------------------------------------------------------------------

# <FILL IN>  Public. Appears in the consent URL and pairs with the access token.
KITE_API_KEY=

# <FILL IN>  SECRET. Used only to compute sha256(api_key + request_token +
# api_secret) inside this process. Never transmitted, never logged, never
# returned by any API. Paste the RAW value — no quotes, no <angle brackets>.
KITE_API_SECRET=

# Informational only (Kite uses its registered copy); set so the status surface
# can show operators where the browser will land.
KITE_REDIRECT_URL=https://gtsalgoresearch.online/api/broker/zerodha/callback

# Endpoint overrides. LEAVE EMPTY — the defaults are the live Zerodha endpoints.
KITE_LOGIN_URL=
KITE_API_ROOT=


# -----------------------------------------------------------------------------
# Dhan app — required only if you want Dhan as a standby broker
#
# Register the app's Redirect URL as DHAN_REDIRECT_URL below.
# Leave this whole block empty for a Zerodha-only deployment; Dhan will simply
# report "not configured", which is a normal state and blocks nothing.
# -----------------------------------------------------------------------------

# <FILL IN, or leave empty for Zerodha-only>
DHAN_CLIENT_ID=
DHAN_API_KEY=
DHAN_API_SECRET=

DHAN_REDIRECT_URL=https://gtsalgoresearch.online/api/broker/dhan/callback

# Optional order-postback URL on the Dhan app. Not used by the login.
DHAN_POSTBACK_URL=

# Consent endpoints. LEAVE EMPTY unless the Dhan sign-in fails with
# "Dhan did not return a consent id" — Dhan ships this flow under two naming
# schemes and the error message names the six variables to switch. See
# docs/BROKER_TOKENS.md.
DHAN_AUTH_ROOT=
DHAN_CONSENT_GENERATE_PATH=
DHAN_CONSENT_CONSUME_PATH=
DHAN_CONSENT_LOGIN_URL=
DHAN_CONSENT_ID_PARAM=
DHAN_AUTH_ID_HEADER=
DHAN_AUTH_SECRET_HEADER=


# -----------------------------------------------------------------------------
# Token exposure — let OTHER SERVERS fetch the token this deployment minted
#
#   GET /api/tokens/zerodha    header  x-token-access-key: <TOKEN_EXPOSURE_KEY>
#   GET /api/tokens/dhan       header  x-token-access-key: <TOKEN_EXPOSURE_KEY>
#
# Returns { broker, access_token, identity, login_date, expires_at, active,
# fetched_at }. `identity` is what the token must be PAIRED with: the Kite
# api_key for Zerodha, the client id for Dhan.
#
# These are the ONLY two routes in this backend that return a plaintext token.
#   * OFF BY DEFAULT — unset means every request gets 503. Opt in deliberately.
#   * A key under 32 characters is REFUSED, not honoured.
#   * SERVE OVER TLS ONLY, and restrict it at the nginx/network layer (see the
#     commented allow/deny block in deploy/nginx.conf). The body is a live
#     trading credential.
#   * Signing out here does NOT revoke at the broker — a service that already
#     fetched the token keeps it until the broker expires it.
# -----------------------------------------------------------------------------

# <FILL IN only if you need it>  openssl rand -base64 48
TOKEN_EXPOSURE_KEY=


# -----------------------------------------------------------------------------
# Broker selection
#
# Exactly ONE broker is active at a time. BOTH can hold a session simultaneously;
# which one TRADES is a separate, blocker-checked choice via the UI
# (POST /api/broker/select). Signing in never makes a broker active.
# -----------------------------------------------------------------------------

# Which broker a FRESH deployment starts on. Honoured only when PostgreSQL holds
# no active_broker row — after that the durable record wins, so a restart never
# silently reverts an operator's switch.
DEFAULT_ACTIVE_BROKER=zerodha

# KEEP FALSE. With it false, losing Zerodha is REPORTED rather than silently
# moving speculative entry to Dhan — changing venue is a trading decision.
# It never affects exits, protective cancellation or reconciliation.
AUTO_FALLBACK_TO_DHAN=false


# -----------------------------------------------------------------------------
# LIVE TRADING GATES — all four must be explicit before a real order is possible,
# and the runtime must ALSO be armed in the UI. Leave all four as-is to stay in
# paper. Read src/box/LIVE_EXECUTION.md before changing any of them.
# -----------------------------------------------------------------------------

# paper_latency | paper_legging | live_parity | live
BOX_EXECUTION_MODE=paper_latency

# The shared live master switch.
BOX_LIVE_TRADING_ENABLED=false

# Per-broker gates — the ACTIVE broker's own gate must also be true.
ZERODHA_LIVE_TRADING_ENABLED=false
DHAN_LIVE_TRADING_ENABLED=false


# -----------------------------------------------------------------------------
# Dhan safety — Dhan order submission is IP-whitelisted at the broker
# -----------------------------------------------------------------------------

# The whitelisted egress IP this server presents to Dhan. Find it with:
#   curl -s https://checkip.amazonaws.com
DHAN_STATIC_PUBLIC_IP=

DHAN_STATIC_IP_EXPECTED=true

# Enable the Dhan market-data API. Keep false while Zerodha is the active broker.
DHAN_DATA_ENABLED=false

DHAN_HTTP_TIMEOUT_MS=8000
DHAN_MIN_INTERVAL_MS=120
DHAN_MAX_READ_ATTEMPTS=3


# -----------------------------------------------------------------------------
# MongoDB — an ASYNC reporting replica, never on the execution path.
# PostgreSQL is the authority and the backup of record. Optional.
# -----------------------------------------------------------------------------

# <FILL IN, or leave empty to disable export entirely>
MONGODB_URI=

# Export runs only when this is true AND MONGODB_URI is set.
MONGO_EXPORT_ENABLED=false


# -----------------------------------------------------------------------------
# Reservation identity — namespaces durable locks so two deployments never take
# each other's. DEVELOPMENT AND PRODUCTION MUST NOT SHARE ONE.
#
# The CALSPREAD_ prefix is compatibility-sensitive and deliberately NOT renamed:
# it is part of the durable owner id stored in PostgreSQL reservation rows.
# Set the values; keep the names.
# -----------------------------------------------------------------------------
CALSPREAD_DEPLOYMENT_ID=production

# Host label used in owner ids and conflict logs. Empty = hostname.
CALSPREAD_INSTANCE_ID=


# -----------------------------------------------------------------------------
# The only Box strategy knobs set explicitly — these are YOUR trading thresholds.
# Everything else in src/box/config.ts is left at its default ON PURPOSE.
# -----------------------------------------------------------------------------

# Minimum GROSS edge (₹) from the spread alone — a cheap prefilter.
MIN_BOX_GROSS_EDGE=1200

# THE ENTRY GATE: minimum projected NET profit (₹) after every cost.
BOX_MIN_EXPECTED_NET_PROFIT=1200

# Conservative slippage/safety allowance (₹) per round trip, in the NET figure.
BOX_SAFETY_BUFFER=150

# Auto-exit floor: a box closes only once current net P&L (₹) reaches this.
BOX_MIN_EXIT_NET_PNL=600

# ATM window width: 1 = ATM±1, 2 = ATM±2, 3 = ATM±3.
BOX_STRIKE_LEVEL=2


# =============================================================================
# NOT SET, and why
#
# KITE_TOKEN_BROKER_URL / KITE_TOKEN_BROKER_PASSCODE / DHAN_TOKEN_URL /
# DHAN_TOKEN_BROKER_PASSCODE / BROKER_TOKEN_POLL_*      ignored when
#   BROKER_LOGIN_MODE=in_app. Add them back only if you set provider mode.
#
# KITE_API_KEY_EXPECTED / DHAN_CLIENT_ID_EXPECTED       provider-mode token
#   validation only. Not used by the in-app login.
#
# ZERODHA_ORDER_STREAM_ENABLED / DHAN_ORDER_STREAM_ENABLED
#   The WebSocket order-update fast path. It CANNOT be used in paper mode — the
#   consumer is constructed only in live mode — so setting these now changes
#   nothing. Arm them only during supervised live validation; REST reconciliation
#   remains the authority of record either way, because neither broker promises
#   replay after a disconnect. See docs/BROKER_STREAM_DOCS.md.
#
# All DHAN_*/BOX_* charge-card rates                    the shipped values ARE
#   the contract notes. Only change one if a broker changes its rate card.
#
# BROKER_TOKEN_OLD_KEY / BROKER_TOKEN_NEW_KEY           used only by
#   `npm run rotate:broker-token-key`. Not read by the running server.
#
# LEGACY_BOX_MONGODB_URI                                one-time legacy import.
# =============================================================================
