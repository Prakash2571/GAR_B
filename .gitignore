/node_modules
/dist
.env
.env.*
!.env.example
*.log
.DS_Store
# TypeScript incremental build artifact — regenerated by every build, and committing it makes the
# working tree dirty after `npm run build` (which blocks `git pull` on the deploy box).
tsconfig.tsbuildinfo

# Host-specific deployment overrides read by start.sh (paths, web root, backup dir).
# NEVER commit: it describes one machine, and may name internal hosts.
deploy.env
