{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "box-config.schema.json",
  "title": "GET /api/box/config (200)",
  "description": "The active Box scanner configuration. Source: src/box/engine.ts getConfig(). Obtained via a DIRECT call to the REAL BoxEngine.getConfig() on a hermetically-constructed engine (inert market-data/feed/broker/charge stubs, no I/O): the /api/box/config route registrar simply does res.json(engine.getConfig()), so the engine method is the authoritative producer of the exact wire bytes and needs no live database or feed to call. CLOSED at top level and for the tunable bounds so an added field is caught.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "min_expected_net_profit", "min_gross_edge", "min_net_edge", "execution_mode",
    "simulated_decision_ms", "simulated_latency_ms", "expected_entry_slippage",
    "expected_exit_slippage", "enable_short_box", "directions", "min_captured_pct",
    "reconcile_charges", "charge_reconcile_warn_pct", "require_priced_charges", "safety_buffer",
    "quote_max_age_ms", "feed_max_age_ms", "underlying_max_age_ms", "strikes_each_side",
    "strike_level", "max_strikes", "max_candidates_per_underlying", "prefilter_gross_threshold",
    "convergence_floor", "convergence_pct", "min_exit_net_pnl", "profit_capture_pct",
    "expiry_safety_minutes", "max_subscribed_tokens", "lots", "universe", "indicative_discovery",
    "closed_cache_enabled", "tunable", "one_opportunity_per_underlying",
    "lot_relative_thresholds", "min_expected_net_profit_per_unit", "min_gross_edge_per_unit",
    "safety_buffer_per_unit", "expected_entry_slippage_per_unit",
    "expected_exit_slippage_per_unit", "min_exit_net_pnl_per_unit"
  ],
  "properties": {
    "min_expected_net_profit": { "type": "number" },
    "min_gross_edge": { "type": "number" },
    "min_net_edge": { "type": "number" },
    "execution_mode": { "type": "string" },
    "simulated_decision_ms": { "type": "number" },
    "simulated_latency_ms": { "type": "number" },
    "expected_entry_slippage": { "type": "number" },
    "expected_exit_slippage": { "type": "number" },
    "enable_short_box": { "type": "boolean" },
    "directions": { "type": "array", "items": { "enum": ["LONG_BOX", "SHORT_BOX"] } },
    "min_captured_pct": { "type": "number" },
    "reconcile_charges": { "type": "boolean" },
    "charge_reconcile_warn_pct": { "type": "number" },
    "require_priced_charges": { "type": "boolean" },
    "safety_buffer": { "type": "number" },
    "quote_max_age_ms": { "type": "number" },
    "feed_max_age_ms": { "type": "number" },
    "underlying_max_age_ms": { "type": "number" },
    "strikes_each_side": { "type": "number" },
    "strike_level": { "type": "number" },
    "max_strikes": { "type": "number" },
    "max_candidates_per_underlying": { "type": "number" },
    "prefilter_gross_threshold": { "type": "number" },
    "convergence_floor": { "type": "number" },
    "convergence_pct": { "type": "number" },
    "min_exit_net_pnl": { "type": "number" },
    "profit_capture_pct": { "type": "number" },
    "expiry_safety_minutes": { "type": "number" },
    "max_subscribed_tokens": { "type": "number" },
    "lots": { "type": "number" },
    "universe": { "type": "string" },
    "indicative_discovery": { "type": "boolean" },
    "closed_cache_enabled": { "type": "boolean" },
    "one_opportunity_per_underlying": {
      "type": "boolean",
      "description": "Whether the published opportunity list is collapsed to the best candidate per (underlying, direction). A PUBLICATION rule, not an entry control: at BOX_STRIKE_LEVEL=1 a name has three strike pairs that move together, so one dislocation otherwise appears as three rows and crowds other names off a list capped at max_published_opportunities. Rows describing a Box that is actually open are never collapsed. The per-underlying ENTRY guarantee is one_active_box_per_underlying, reported on box-execution-control."
    },
    "lot_relative_thresholds": {
      "type": "boolean",
      "description": "True when at least one per-unit rate below is non-zero, i.e. thresholds resolve as max(flat, rate x lotSize) per candidate rather than as one flat rupee figure for every instrument. Published because the flat figures alone cannot express which regime is active, and the two screen a mixed universe very differently: with flat-only gates the effective hurdle is flat/lotSize per unit, which varies by ~1000x across F&O lot sizes and concentrates every entry in the largest-lot underlyings."
    },
    "min_expected_net_profit_per_unit": { "type": "number" },
    "min_gross_edge_per_unit": { "type": "number" },
    "safety_buffer_per_unit": { "type": "number" },
    "expected_entry_slippage_per_unit": { "type": "number" },
    "expected_exit_slippage_per_unit": { "type": "number" },
    "min_exit_net_pnl_per_unit": { "type": "number" },
    "tunable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_expected_net_profit", "safety_buffer"],
      "properties": {
        "min_expected_net_profit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": { "min": { "type": "number" }, "max": { "type": "number" } }
        },
        "safety_buffer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": { "min": { "type": "number" }, "max": { "type": "number" } }
        }
      }
    }
  }
}
